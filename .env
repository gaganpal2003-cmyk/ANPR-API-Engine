# =====================================================================
# ANPR API CONFIGURATION
# =====================================================================

# Server Host & Port
ANPR_API_HOST=0.0.0.0
ANPR_API_PORT=8000

# API URL (Used by clients to connect to your API)
# For local testing use: http://localhost:8000
# For network/remote use: http://<YOUR_IP>:8000 (e.g. http://192.168.1.9:8000)
ANPR_API_URL=http://localhost:8000

# Secret API Key (Required in every request: header X-API-Key or ?api_key=...)
ANPR_API_KEY=anpr_live_secret_key_2026

# Detection Confidence Thresholds (0.01 to 0.99)
ANPR_CONF_THRESHOLD=0.15
ANPR_OCR_CONF_THRESHOLD=0.15

# Compute Device: leave empty for auto-detect (cuda:0 if GPU available, else cpu)
ANPR_DEVICE=
